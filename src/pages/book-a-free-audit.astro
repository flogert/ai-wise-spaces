---
import ContactSubmissionSection from '../features/contact/components/ContactSubmissionSection.astro';
import PageAnswerSummary from '../components/PageAnswerSummary.astro';
import Layout from '../layouts/Layout.astro';

const auditSummaryItems = [
	{
		label: 'What this is',
		detail: 'A simple entry point for getting outside eyes on clarity, trust, and visibility issues on your current site.',
	},
	{
		label: 'What it is not',
		detail: 'It is not the full paid audit. It is a lighter review that helps you understand the next move.',
	},
	{
		label: 'Who should use it',
		detail: 'Businesses that know the site is underperforming but want quick direction before buying deeper work.',
	},
	{
		label: 'Best next move after this',
		detail: 'If the problems are larger than quick notes can solve, move into the full visibility audit or a rebuild plan.',
	},
];

const auditSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: 'Free website review request',
	description:
		'Send website details to receive simple improvement notes on clarity, trust, and visibility before purchasing a full audit.',
};
---

<Layout
	title="Free Website Review | AI Visibility Audit Request | AI Wise Spaces"
	description="Request a free website review to uncover clarity, trust, SEO, and conversion issues before committing to a full visibility audit."
	keywords="free website review, AI visibility audit request, local service business website review, SEO audit request, website improvement notes"
	schema={auditSchema}
>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="container page-hero">
			<p class="eyebrow">FREE WEBSITE REVIEW REQUEST</p>
			<h1 class="page-title">Send your site and get <span class="title-accent">quick clarity on what to improve first.</span></h1>
			<p class="page-lede">This free request surfaces the most obvious problems affecting clarity, trust, and visibility so you can decide whether quick fixes or deeper work is the right next move.</p>
		</section>

		<PageAnswerSummary
			id="audit-summary-title"
			title="What happens after you request a review."
			intro="Prospects should know exactly what they are getting here, what they are not getting yet, and how to move forward if the site needs more work."
			items={auditSummaryItems}
			actions={[
				{ label: 'See pricing', href: '/pricing', variant: 'secondary' },
				{ label: 'Compare services', href: '/services', variant: 'secondary' },
			]}
		/>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">WHAT YOU GET</p>
					<h2>Free request first. Full audit second.</h2>
				</div>
				<div class="detail-grid review-flow-grid">
					<article class="detail-card compact-detail-card">
						<p class="case-label">Free request</p>
						<h2>Short improvement notes</h2>
						<p>We review the basics and send a simple set of next-step notes on messaging, structure, trust, or visibility gaps.</p>
					</article>
					<article class="detail-card compact-detail-card">
						<p class="case-label">Paid audit</p>
						<h2>Full Visibility Audit for $150</h2>
						<p>The paid audit includes a deeper review, clearer prioritization, and a fuller action plan than the free request.</p>
					</article>
				</div>
				<div class="built-for-shell">
					<p class="built-for-heading">Built for</p>
					<div class="built-for-grid">
						<span class="built-for-item">Contractors</span>
						<span class="built-for-item">Roofers</span>
						<span class="built-for-item">Plumbers</span>
						<span class="built-for-item">Yoga Studios</span>
						<span class="built-for-item">Photographers</span>
						<span class="built-for-item">Salons</span>
						<span class="built-for-item">Restaurants</span>
						<span class="built-for-item">Coffee Shops</span>
						<span class="built-for-item">Gyms</span>
						<span class="built-for-item">Med Spas</span>
						<span class="built-for-item">Auto Repair</span>
						<span class="built-for-item">Local Service Brands</span>
					</div>
				</div>
			</div>
		</section>

		<ContactSubmissionSection />
	</main>
</Layout>