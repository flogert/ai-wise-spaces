---
import ContactSubmissionSection from '../features/contact/components/ContactSubmissionSection.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Free Website Review Request | Simple Website Improvement Notes"
	description="Send your website details and get a short set of simple improvement notes. The full Visibility Audit is the paid $150 option."
	keywords="free website review request, simple website improvement notes, paid visibility audit Lancaster PA, local service business website review"
>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="container page-hero">
			<p class="eyebrow">FREE WEBSITE REVIEW REQUEST</p>
			<h1 class="page-title">Send your site and get <span class="title-accent">quick notes on what to improve.</span></h1>
			<p class="page-lede">This free request sends simple improvement details on what may be hurting clarity, trust, and visibility. The full Visibility Audit is the paid $150 deliverable shown on the pricing page.</p>
		</section>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">WHAT YOU GET</p>
					<h2>Free request first. Full audit second.</h2>
				</div>
				<div class="detail-grid review-flow-grid">
					<article class="detail-card compact-detail-card">
						<p class="case-label">Free request</p>
						<h2>Short improvement notes</h2>
						<p>We review the basics and send a simple set of next-step notes on messaging, structure, trust, or visibility gaps.</p>
					</article>
					<article class="detail-card compact-detail-card">
						<p class="case-label">Paid audit</p>
						<h2>Full Visibility Audit for $150</h2>
						<p>The paid audit includes a deeper review, clearer prioritization, and a fuller action plan than the free request.</p>
					</article>
				</div>
				<div class="built-for-shell">
					<p class="built-for-heading">Built for</p>
					<div class="built-for-grid">
						<span class="built-for-item">Contractors</span>
						<span class="built-for-item">Roofers</span>
						<span class="built-for-item">Plumbers</span>
						<span class="built-for-item">Yoga Studios</span>
						<span class="built-for-item">Photographers</span>
						<span class="built-for-item">Salons</span>
						<span class="built-for-item">Restaurants</span>
						<span class="built-for-item">Coffee Shops</span>
						<span class="built-for-item">Gyms</span>
						<span class="built-for-item">Med Spas</span>
						<span class="built-for-item">Auto Repair</span>
						<span class="built-for-item">Local Service Brands</span>
					</div>
				</div>
			</div>
		</section>

		<ContactSubmissionSection />
	</main>
</Layout>