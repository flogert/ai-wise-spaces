---
import { aboutPillars, process, services } from '../data/siteContent.js';
import PageAnswerSummary from '../components/PageAnswerSummary.astro';
import UiIcon from '../components/UiIcon.astro';
import Layout from '../layouts/Layout.astro';

const aboutSummaryItems = [
	{
		label: 'Operating principle',
		detail: 'Make the business easier to understand, trust, and contact before adding more marketing complexity.',
	},
	{
		label: 'How we differ',
		detail: 'The work stays practical, lead-focused, and grounded in site structure instead of vague agency promises.',
	},
	{
		label: 'Who benefits most',
		detail: 'Businesses with good real-world service quality but weak digital presentation and weak conversion flow.',
	},
	{
		label: 'Expected result',
		detail: 'A site that explains the offer better, earns trust faster, and creates stronger local buying momentum.',
	},
];

const aboutSchema = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	name: 'About AI Wise Spaces',
	description:
		'AI Wise Spaces helps local service businesses improve website messaging, AI solutions readiness, local SEO, and lead generation with practical, focused work.',
	mainEntity: {
		'@type': 'Organization',
		name: 'AI Wise Spaces',
		url: 'https://aiwisespaces.com',
	},
};
---

<Layout
	title="About AI Wise Spaces | AI Solutions, SEO & Website Strategy"
	description="Learn how AI Wise Spaces helps contractors and local service businesses improve website clarity, AI solutions readiness, local SEO, trust, and lead generation with practical strategy."
	keywords="about AI Wise Spaces, AI solutions strategy, contractor website marketing, local service business SEO help, website lead generation"
	schema={aboutSchema}
>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="container page-hero">
			<p class="eyebrow">ABOUT</p>
			<h1 class="page-title">We help local service businesses turn weak websites into <span class="title-accent">better lead systems.</span></h1>
			<p class="page-lede">Our work is focused on one outcome: making websites clearer, more trustworthy, and more likely to turn local traffic into calls, form fills, and booked jobs through practical AI solutions, stronger structure, and better local search positioning.</p>
		</section>

		<PageAnswerSummary
			id="about-summary-title"
			title="What AI Wise Spaces is optimizing for."
			intro="This is the shortest accurate explanation of how the business thinks about website performance, trust, and lead quality."
			items={aboutSummaryItems}
			actions={[
				{ label: 'See the process', href: '/process', variant: 'secondary' },
				{ label: 'Request a review', href: '/book-a-free-audit', variant: 'primary' },
			]}
		/>

		<section class="container page-section two-column-callout">
			<div class="page-band about-intro-card">
				<div class="section-heading compact">
					<p class="eyebrow">HOW WE WORK</p>
					<h2>Compact, practical, and built around lead quality.</h2>
				</div>
				<p>We start by identifying where a website is unclear, where trust is weak, and where structure makes it difficult for the right customer to understand what the business offers.</p>
				<p>Then we simplify the message, tighten the page structure, strengthen local trust signals, and make the next step easier to take.</p>
				<ul class="bullet-list compact-bullet-list">
					<li>Clearer service messaging</li>
					<li>Stronger local SEO structure</li>
					<li>Better lead capture paths</li>
					<li>Less fluff and less confusion</li>
				</ul>
			</div>
			<div class="about-pillars-grid">
				{aboutPillars.map((pillar) => (
					<article class="stack-card about-pillar-card">
						<p class="case-label">Core principle</p>
						<h2>{pillar.title}</h2>
						<p>{pillar.text}</p>
					</article>
				))}
			</div>
		</section>

		<section class="container page-section">
			<div class="detail-grid">
				{services.map((service) => (
					<article class="detail-card compact-detail-card">
						<p class="case-label">Service focus</p>
						<h2>{service.title}</h2>
						<p>{service.description}</p>
					</article>
				))}
			</div>
		</section>

		<section class="container page-section">
			<div class="section-heading">
				<p class="eyebrow">OUR PROCESS</p>
				<h2>The sequence we use to turn unclear websites into better sales tools.</h2>
			</div>
			<div class="process-timeline">
				{process.map((item) => (
					<article class="process-step">
						<div class="timeline-node">
							<UiIcon name={item.icon} />
						</div>
						<p class="step-number">{item.step}</p>
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))}
			</div>
		</section>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">WHAT CHANGES</p>
					<h2>Every improvement is designed to make the website easier to trust, find, and contact.</h2>
				</div>
				<ul class="bullet-list compact-bullet-list">
					<li>Service pages become clearer and more specific.</li>
					<li>Local signals are stronger for Lancaster and Pennsylvania searches.</li>
					<li>FAQ content and proof make the site easier to trust.</li>
					<li>Calls to action and lead capture paths become simpler and more persuasive.</li>
					<li>The site gains a more durable foundation for long-term lead generation.</li>
				</ul>
			</div>
		</section>
	</main>
</Layout>