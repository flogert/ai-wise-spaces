---
import { blogPosts } from '../data/siteContent.js';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Website Marketing Blog | Leads, Local SEO, and Better Service Pages"
	description="Read practical articles on getting more calls from your website, improving local SEO, and building clearer service pages for contractors and local businesses."
	keywords="website marketing blog Lancaster, contractor SEO tips, local service business website tips, get more calls from website"
>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="container page-hero">
			<p class="eyebrow">BLOG</p>
			<h1 class="page-title">Simple thinking on local SEO, <span class="title-accent">better websites, and more calls.</span></h1>
			<p class="page-lede">This is where we publish practical explanations, frameworks, and examples that help service businesses understand what actually improves visibility and lead flow.</p>
		</section>

		<section class="container page-section">
			<div class="article-grid">
				{blogPosts.map((post) => (
					<article class="stack-card article-card">
						<p class="case-label">{post.category}</p>
						<h2>{post.title}</h2>
						<p>{post.summary}</p>
						<p>{post.preview}</p>
						<a class="button button-secondary" href={`/blog/${post.slug}`}>Read More</a>
					</article>
				))}
			</div>
		</section>
	</main>
</Layout>