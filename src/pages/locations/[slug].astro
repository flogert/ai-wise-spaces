---
import ContactSubmissionSection from '../../features/contact/components/ContactSubmissionSection.astro';
import PageAnswerSummary from '../../components/PageAnswerSummary.astro';
import { process, serviceAreas, services } from '../../data/siteContent.js';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export function getStaticPaths() {
	return serviceAreas.map((area) => ({
		params: { slug: area.slug },
		props: { area },
	}));
}

const { area } = Astro.props;
const countyLabel = area.city === 'Lancaster' ? 'Lancaster County' : `${area.city} and nearby Pennsylvania markets`;

const faqItems = [
	{
		question: `Can you help ${area.city} businesses get more calls from their website?`,
		answer: `Yes. We help ${area.city} businesses improve website messaging, local SEO, FAQ content, and lead capture so more of the right visitors turn into inquiries.`,
	},
	{
		question: `Do you work with contractors, roofers, and plumbers in ${area.city}?`,
		answer: `Yes. We work best with local service businesses that rely on calls, estimate requests, and a strong local reputation to win work.`,
	},
	{
		question: `Do I need a full rebuild to improve my website in ${area.city}?`,
		answer: 'Not always. Some businesses need a rebuild, while others only need stronger service pages, local SEO improvements, and clearer calls to action.',
	},
];

const pageSchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: `AI Solutions, AI Web Marketing, and AEO Help in ${area.city}, ${area.state}`,
		areaServed: { '@type': 'City', name: area.city },
		description: `AI solutions, AI web marketing, and local SEO help for ${area.city}, ${area.state} businesses that need stronger visibility, trust, and lead flow.`,
		serviceType: 'AI solutions, AI web marketing, Answer Engine Optimization, local SEO, website strategy',
		provider: {
			'@type': 'Organization',
			name: 'AI Wise Spaces',
			url: 'https://aiwisespaces.com/',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
];

const pageSummaryItems = [
	{
		label: 'Local fit',
		detail: `${area.city} businesses that need stronger service clarity, local trust, and better lead flow from the website.`,
	},
	{
		label: 'What usually needs work',
		detail: area.problems.join(' '),
	},
	{
		label: 'What improves performance',
		detail: `Clearer service pages, stronger local relevance, and simpler next steps for buyers in and around ${area.city}.`,
	},
	{
		label: 'Nearby context',
		detail: `This city page also considers how buyers compare providers across nearby markets like ${area.nearby.join(', ')}.`,
	},
];
---

<Layout
	title={`${area.city}, ${area.state} AI Solutions, SEO & Website Help | AI Wise Spaces`}
	description={`AI solutions, AI web marketing, and website help for ${area.city}, ${area.state} businesses that want stronger local visibility, AEO support, and better lead flow.`}
	keywords={`${area.keywords}, AI solutions ${area.city} ${area.state}, AI solutions ${area.city} businesses`}
	socialImagePath="/og-locations.svg"
	schema={pageSchema}
>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="container page-hero">
			<p class="eyebrow">{area.city.toUpperCase()}</p>
			<h1 class="page-title">Get more local jobs with a <span class="title-accent">better website</span> in {area.city}, {area.state}.</h1>
			<p class="page-lede">{area.intro} We focus on {countyLabel} business owners who need stronger AI web marketing, AEO visibility, clearer offers, and better lead flow.</p>
		</section>

		<PageAnswerSummary
			id="location-summary-title"
			title={`What this ${area.city} page is meant to answer.`}
			intro={`This summary helps local buyers and answer engines understand the city-specific AI web marketing and AEO fit before moving into service detail for ${area.city}.`}
			items={pageSummaryItems}
			actions={[
				{ label: 'See services', href: '/services', variant: 'secondary' },
				{ label: 'Request a review', href: '/book-a-free-audit', variant: 'primary' },
			]}
		/>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">LOCAL NEEDS</p>
					<h2>Common website and marketing issues we help fix for {area.city} contractors and service businesses.</h2>
				</div>
				<ul class="bullet-list">
					{area.problems.map((problem) => <li>{problem}</li>)}
				</ul>
			</div>
		</section>

		<section class="container page-section">
			<div class="detail-grid">
				{services.map((service) => (
					<article class="detail-card">
						<p class="case-label">Built for {area.city} businesses</p>
						<h2>{service.title}</h2>
						<p>{service.description}</p>
					</article>
				))}
			</div>
		</section>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">NEARBY MARKETS</p>
					<h2>We also support nearby service businesses around {area.city}.</h2>
				</div>
				<p class="page-lede">Nearby markets we often think about when structuring local visibility: {area.nearby.join(', ')}.</p>
				<div class="mini-process-grid">
					{process.map((item) => (
						<div class="mini-process-step">
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">RELATED PAGES</p>
					<h2>Explore the next most useful SEO and website pages for {area.city} businesses.</h2>
				</div>
				<div class="detail-grid">
					<article class="detail-card compact-detail-card">
						<p class="case-label">Commercial next step</p>
						<h2>Compare services and pricing</h2>
						<p>See which audit, rebuild, or ongoing support option fits your current website and lead-flow problem.</p>
						<div class="hero-actions">
							<a class="button button-secondary" href="/services">See services</a>
							<a class="button button-secondary" href="/ai-solutions-lancaster-pa">See AI solutions</a>
						</div>
					</article>
					<article class="detail-card compact-detail-card">
						<p class="case-label">Local context</p>
						<h2>Read more Pennsylvania market pages</h2>
						<p>Compare nearby city pages and statewide contractor resources to see how local positioning changes by market.</p>
						<div class="hero-actions">
							<a class="button button-secondary" href="/locations">View all service areas</a>
							<a class="button button-secondary" href="/contractor-leads-pennsylvania">Pennsylvania contractor page</a>
						</div>
					</article>
				</div>
			</div>
		</section>

		<section class="container page-section">
			<div class="section-heading">
				<p class="eyebrow">FAQ</p>
				<h2>Simple answers for businesses in {area.city}.</h2>
			</div>
			<div class="faq-list">
				{faqItems.map((item) => (
					<details class="faq-item">
						<summary>{item.question}</summary>
						<p>{item.answer}</p>
					</details>
				))}
			</div>
		</section>

		<ContactSubmissionSection />
	</main>
</Layout>