---
import ContactSubmissionSection from '../features/contact/components/ContactSubmissionSection.astro';
import PageAnswerSummary from '../components/PageAnswerSummary.astro';
import Layout from '../layouts/Layout.astro';

const faqItems = [
	{
		question: 'Can you help Pennsylvania contractors get better website leads?',
		answer: 'Yes. We help contractors improve service pages, local SEO, trust signals, and conversion paths so more of the right visitors turn into inquiries.',
	},
	{
		question: 'Do you only work in Lancaster?',
		answer: 'No. Lancaster is a core market, but we also support businesses across Pennsylvania including Harrisburg, York, Allentown, Philadelphia, Reading, Bethlehem, and Lebanon.',
	},
	{
		question: 'What should a contractor website do better?',
		answer: 'A strong contractor website should explain services clearly, show proof, answer common questions, and make the next step obvious for a local buyer.',
	},
];

const pageSchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: 'AI Solutions, AI Web Marketing, and AEO for Pennsylvania Contractors',
		description: 'AI solutions, AI web marketing, AEO, local SEO, and service-page help for Pennsylvania contractors who want more local jobs and better leads.',
		serviceType: 'AI solutions, AI web marketing, Answer Engine Optimization, local SEO, contractor website strategy',
		areaServed: { '@type': 'AdministrativeArea', name: 'Pennsylvania' },
		provider: {
			'@type': 'Organization',
			name: 'AI Wise Spaces',
			url: 'https://aiwisespaces.com/',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
];

const pageSummaryItems = [
	{
		label: 'Who this helps',
		detail: 'Pennsylvania contractors who need better lead quality from a site that explains services and geography clearly.',
	},
	{
		label: 'What creates better leads',
		detail: 'Clear service positioning, stronger proof, and pages aligned to real buyer intent instead of generic branding language.',
	},
	{
		label: 'Why this matters',
		detail: 'The website should filter for better-fit jobs and make it easier for local buyers to trust the business quickly.',
	},
	{
		label: 'Best next step',
		detail: 'If your site gets traffic but weak inquiries, a review can identify the highest-leverage fixes first.',
	},
];
---

<Layout
	title="Pennsylvania Contractor Website Help | AI Solutions, SEO & Lead Generation | AI Wise Spaces"
	description="AI solutions, AI web marketing, AEO, local SEO, and website strategy for Pennsylvania contractors who want better visibility, stronger calls, and more qualified leads."
	keywords="AI solutions Pennsylvania contractors, AI web marketing Pennsylvania contractors, AEO Pennsylvania, contractor SEO Pennsylvania, contractor website help Pennsylvania, lead generation PA"
	socialImagePath="/og-locations.svg"
	schema={pageSchema}
>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="container page-hero">
			<p class="eyebrow">CONTRACTORS</p>
			<h1 class="page-title">Get more local jobs from a website built for <span class="title-accent">lead flow, not just design.</span></h1>
			<p class="page-lede">We help Pennsylvania contractors improve AI web marketing, AEO visibility, local SEO, and website clarity so the site brings in more qualified leads from both search engines and answer engines.</p>
		</section>

		<PageAnswerSummary
			id="contractor-summary-title"
			title="What this contractor page is meant to answer."
			intro="A direct summary helps Pennsylvania contractors understand the fit before moving into deeper AI web marketing, AEO, and local SEO detail."
			items={pageSummaryItems}
			actions={[
				{ label: 'See services', href: '/services', variant: 'secondary' },
				{ label: 'Request a review', href: '/book-a-free-audit', variant: 'primary' },
			]}
		/>

		<section class="container page-section">
			<div class="section-heading">
				<p class="eyebrow">WHO THIS FITS</p>
				<h2>Best for contractors who rely on local trust and estimate requests.</h2>
			</div>
			<div class="detail-grid">
				<article class="detail-card">
					<h2>Roofing</h2>
					<p>Clear service pages and stronger proof help roofers earn more estimate requests from local homeowners.</p>
				</article>
				<article class="detail-card">
					<h2>General contracting</h2>
					<p>Broader service offers need stronger structure so buyers can understand exactly what work you handle.</p>
				</article>
				<article class="detail-card">
					<h2>Trades</h2>
					<p>Plumbers, HVAC companies, electricians, and landscapers benefit from clearer pages and faster lead paths.</p>
				</article>
			</div>
		</section>

		<section class="container page-section">
			<div class="section-heading">
				<p class="eyebrow">FAQ</p>
				<h2>Questions Pennsylvania contractors ask.</h2>
			</div>
			<div class="faq-list">
				{faqItems.map((item) => (
					<details class="faq-item">
						<summary>{item.question}</summary>
						<p>{item.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">RELATED PAGES</p>
					<h2>Explore the strongest next pages for Pennsylvania contractors.</h2>
				</div>
				<div class="detail-grid">
					<article class="detail-card compact-detail-card">
						<p class="case-label">Service planning</p>
						<h2>Choose the right service path</h2>
						<p>Compare the services and pricing pages if you need to decide between a strategic audit, a rebuild, or ongoing support.</p>
						<div class="hero-actions">
							<a class="button button-secondary" href="/services">See services</a>
							<a class="button button-secondary" href="/ai-solutions-lancaster-pa">See AI solutions</a>
						</div>
					</article>
					<article class="detail-card compact-detail-card">
						<p class="case-label">Search coverage</p>
						<h2>Explore city-specific SEO pages</h2>
						<p>Review the Pennsylvania service-area hub and the Lancaster roofing page to see how strategy changes by city and trade.</p>
						<div class="hero-actions">
							<a class="button button-secondary" href="/locations">Pennsylvania service areas</a>
							<a class="button button-secondary" href="/roofing-marketing-lancaster-pa">Lancaster roofing page</a>
						</div>
					</article>
				</div>
			</div>
		</section>

		<ContactSubmissionSection />
	</main>
</Layout>