---
import { pricing } from '../data/siteContent.js';
import PageAnswerSummary from '../components/PageAnswerSummary.astro';
import ContactSubmissionSection from '../features/contact/components/ContactSubmissionSection.astro';
import Layout from '../layouts/Layout.astro';

const pricingSummaryItems = [
	{
		label: 'Entry point',
		detail: 'Start with the lower-risk audit if you need clarity before committing to bigger website work.',
	},
	{
		label: 'Most common fit',
		detail: 'The rebuild is for businesses with outdated sites that make selling harder than it should be.',
	},
	{
		label: 'Ongoing support',
		detail: 'Monthly support is for businesses that want continued refinement after the foundation is fixed.',
	},
	{
		label: 'Decision shortcut',
		detail: 'If your site is unclear and underperforming, the audit identifies the fastest route to more trust and better leads.',
	},
];

const pricingSchema = {
	'@context': 'https://schema.org',
	'@type': 'OfferCatalog',
	name: 'AI Wise Spaces pricing',
	itemListElement: pricing.map((tier) => ({
		'@type': 'Offer',
		name: tier.name,
		description: tier.bestFor,
		priceSpecification: {
			'@type': 'PriceSpecification',
			priceCurrency: 'USD',
			price: tier.name === 'Website Rebuild' ? '1500' : tier.name === 'Growth System' ? '450' : tier.price.replace(/[^\d.]/g, ''),
		},
	})),
};

function getPricingDisplay(tier: { name: string; price: string }) {
	if (tier.name === 'Website Rebuild') {
		return {
			prefix: 'Starting from',
			amount: '$1,500',
			cycle: '/project',
		};
	}

	if (tier.name === 'Growth System') {
		return {
			prefix: '',
			amount: '$450',
			cycle: '/month',
		};
	}

	return {
		prefix: '',
		amount: tier.price,
		cycle: '/project',
	};
}
---

<Layout
	title="Pricing | AI Visibility, SEO & Website Services | AI Wise Spaces"
	description="Review pricing for AI visibility audits, website rebuilds, and ongoing growth support for contractors and local service businesses across Pennsylvania."
	keywords="website pricing, AI visibility audit pricing, local SEO pricing, contractor website pricing, website rebuild pricing"
	schema={pricingSchema}
>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="container page-hero">
			<p class="eyebrow">PRICING</p>
			<h1 class="page-title">Choose the level of website help your <span class="title-accent">business actually needs next.</span></h1>
			<p class="page-lede">From a low-risk audit to a full rebuild or monthly refinement, each option is framed to help you buy the next right step instead of overcommitting early.</p>
		</section>

		<PageAnswerSummary
			id="pricing-summary-title"
			title="How to choose the right pricing tier."
			intro="Buyers usually need a simple decision framework before they need feature lists. This section provides that framework directly."
			items={pricingSummaryItems}
			actions={[
				{ label: 'Compare services', href: '/services', variant: 'secondary' },
				{ label: 'Start with a free review', href: '/book-a-free-audit', variant: 'primary' },
			]}
		/>

		<section class="container page-section">
			<div class="pricing-grid">
				{pricing.map((tier) => {
					const pricingDisplay = getPricingDisplay(tier);

					return (
						<article class={`pricing-card${tier.featured ? ' featured' : ''}`}>
							<div class="pricing-head">
								<p class="pricing-label">{tier.featured ? 'Popular' : tier.priceNote}</p>
								<h3>{tier.name}</h3>
								<p class="pricing-summary">{tier.bestFor}</p>
							</div>
							<div class="pricing-price-row">
								{pricingDisplay.prefix && <span class="pricing-prefix">{pricingDisplay.prefix}</span>}
								<strong class="price">{pricingDisplay.amount}</strong>
								<span class="pricing-cycle">{pricingDisplay.cycle}</span>
							</div>
							<div class="pricing-section-label pricing-section-label-muted">What you get</div>
							<ul class="pricing-perks">
								{tier.perks.map((perk) => <li>{perk}</li>)}
							</ul>
							<div class="pricing-section-label pricing-section-label-muted">Includes</div>
							<ul class="pricing-features">
								{tier.features.map((feature) => <li>{feature}</li>)}
							</ul>
							<a class="button button-primary" href="/book-a-free-audit">
								{tier.name === 'Visibility Audit' ? 'Ask About The $150 Audit' : 'Start With A Free Review'}
							</a>
						</article>
					);
				})}
			</div>
		</section>

		<ContactSubmissionSection />
	</main>
</Layout>