---
import { pricing } from '../data/siteContent.js';
import ContactSubmissionSection from '../features/contact/components/ContactSubmissionSection.astro';
import Layout from '../layouts/Layout.astro';

function getPricingDisplay(tier: { name: string; price: string }) {
	if (tier.name === 'Website Rebuild') {
		return {
			prefix: 'Starting from',
			amount: '$1,500',
			cycle: '/project',
		};
	}

	if (tier.name === 'Growth System') {
		return {
			prefix: '',
			amount: '$450',
			cycle: '/month',
		};
	}

	return {
		prefix: '',
		amount: tier.price,
		cycle: '/project',
	};
}
---

<Layout
	title="Website Pricing for Contractors | Lancaster SEO, Websites, and Lead Systems"
	description="Review AI Wise Spaces pricing for contractors and local service businesses in Lancaster and across Pennsylvania, from focused audits to website rebuilds and ongoing growth support."
	keywords="contractor website pricing Lancaster, roofer marketing pricing Lancaster PA, plumber website audit cost, local SEO pricing Pennsylvania, website rebuild pricing contractors"
>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="container page-hero">
			<p class="eyebrow">PRICING</p>
			<h1 class="page-title">Choose the level of website help your business needs next.</h1>
			<p class="page-lede">From a low-risk audit to a full rebuild or monthly growth support, each tier is designed to help local businesses improve clarity, trust, and lead flow.</p>
		</section>

		<section class="container page-section">
			<div class="page-band pricing-note-band">
				<p class="eyebrow">IMPORTANT</p>
				<h2>The free request sends quick improvement notes. The full Visibility Audit is $150.</h2>
				<p>The pricing tier below is the paid, deeper audit. The free request form is only the first step for simple guidance.</p>
			</div>
		</section>

		<section class="container page-section">
			<div class="pricing-grid">
				{pricing.map((tier) => {
					const pricingDisplay = getPricingDisplay(tier);

					return (
						<article class={`pricing-card${tier.featured ? ' featured' : ''}`}>
							<div class="pricing-head">
								<p class="pricing-label">{tier.featured ? 'Popular' : tier.priceNote}</p>
								<h3>{tier.name}</h3>
								<p class="pricing-summary">{tier.bestFor}</p>
							</div>
							<div class="pricing-price-row">
								{pricingDisplay.prefix && <span class="pricing-prefix">{pricingDisplay.prefix}</span>}
								<strong class="price">{pricingDisplay.amount}</strong>
								<span class="pricing-cycle">{pricingDisplay.cycle}</span>
							</div>
							<div class="pricing-section-label pricing-section-label-muted">What you get</div>
							<ul class="pricing-perks">
								{tier.perks.map((perk) => <li>{perk}</li>)}
							</ul>
							<div class="pricing-section-label pricing-section-label-muted">Includes</div>
							<ul class="pricing-features">
								{tier.features.map((feature) => <li>{feature}</li>)}
							</ul>
							<a class="button button-primary" href="/book-a-free-audit">
								{tier.name === 'Visibility Audit' ? 'Ask About The $150 Audit' : 'Start With A Free Review'}
							</a>
						</article>
					);
				})}
			</div>
		</section>

		<ContactSubmissionSection />
	</main>
</Layout>