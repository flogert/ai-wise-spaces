---
import PageAnswerSummary from '../components/PageAnswerSummary.astro';
import UiIcon from '../components/UiIcon.astro';
import { process } from '../data/siteContent.js';
import ContactSubmissionSection from '../features/contact/components/ContactSubmissionSection.astro';
import Layout from '../layouts/Layout.astro';

const processSummaryItems = [
	{
		label: 'Starting point',
		detail: 'We look for the gaps that make a business hard to understand or trust online.',
	},
	{
		label: 'Middle of the work',
		detail: 'We clarify the offer, improve the pages, and remove friction from the next step.',
	},
	{
		label: 'Technical layer',
		detail: 'We support structure, local SEO, and AI-readability so visibility and trust work together.',
	},
	{
		label: 'Business goal',
		detail: 'Better-fit inquiries, stronger conversion, and a website that supports long-term growth instead of dragging it down.',
	},
];

const processSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: 'Website marketing process',
	description:
		'AI Wise Spaces guides local businesses from website audit to clearer messaging, stronger local SEO, and better lead flow.',
};
---

<Layout
	title="Our Process | AI Visibility, SEO & Website Growth | AI Wise Spaces"
	description="See how AI Wise Spaces guides contractors and local service businesses from audit to stronger messaging, local SEO, website clarity, and better lead flow."
	keywords="AI visibility process, contractor SEO workflow, local service website strategy, website audit process, lead generation process"
	schema={processSchema}
>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="container page-hero">
			<p class="eyebrow">PROCESS</p>
			<h1 class="page-title">A clear process from website audit to <span class="title-accent">better local leads.</span></h1>
			<p class="page-lede">Every engagement is designed to help contractors and local service businesses move from unclear messaging to stronger trust, cleaner structure, and better-fit inquiries.</p>
		</section>

		<PageAnswerSummary
			id="process-summary-title"
			title="What the process is meant to accomplish."
			intro="This is the short version of the workflow a prospect or answer engine needs before diving into the step-by-step details."
			items={processSummaryItems}
			actions={[
				{ label: 'View services', href: '/services', variant: 'secondary' },
				{ label: 'Book a free audit', href: '/book-a-free-audit', variant: 'primary' },
			]}
		/>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">HOW IT WORKS</p>
					<h2>We keep the workflow simple so the business outcome stays obvious.</h2>
				</div>
				<p class="page-lede">The goal is not more marketing noise. The goal is to make your business easier to understand, easier to trust, and easier to recommend.</p>
			</div>
		</section>

		<section class="container page-section">
			<div class="process-timeline">
				{process.map((item) => (
					<article class="process-step">
						<div class="timeline-node">
							<UiIcon name={item.icon} />
						</div>
						<p class="step-number">{item.step}</p>
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))}
			</div>
		</section>

		<ContactSubmissionSection />
	</main>
</Layout>