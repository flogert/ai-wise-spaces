---
import {
	faqs,
	logos,
	pricing,
	proofAvatars,
	process,
	services,
	stats,
} from '../data/siteContent.js';
import ContactSubmissionSection from '../features/contact/components/ContactSubmissionSection.astro';
import Layout from '../layouts/Layout.astro';
import UiIcon from '../components/UiIcon.astro';

const heroStories = [
	{
		id: 'clarity',
		title: 'Clarify The Offer',
		text: 'Show Lancaster-area buyers and AI systems exactly what you do, where you work, and why they should trust your business.',
	},
	{
		id: 'authority',
		title: 'Build Local Authority',
		text: 'Layer in service structure, local proof, and semantic signals that strengthen visibility across Pennsylvania searches and AI answers.',
	},
	{
		id: 'convert',
		title: 'Capture Better Leads',
		text: 'Turn a generic brochure site into a local growth system that attracts better-fit inquiries and moves buyers faster.',
	},
];

function getPricingDisplay(tier: { name: string; price: string }) {
	if (tier.name === 'AI Builds') {
		return {
			prefix: 'Starting from',
			amount: '$1,500',
			cycle: '/project',
		};
	}

	if (tier.name === 'AI Growth System') {
		return {
			prefix: '',
			amount: '$450',
			cycle: '/month',
		};
	}

	return {
		prefix: '',
		amount: tier.price,
		cycle: '/project',
	};
}

const homeSchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		name: 'AI Wise Spaces',
		url: 'https://www.aiwisespaces.com/',
		logo: 'https://www.aiwisespaces.com/aiwisespaces.png',
		description:
			'AI Wise Spaces builds AI-optimized websites, machine-readable content systems, and semantic clarity for businesses that want to be understood and recommended by AI in Lancaster, Pennsylvania, and beyond.',
		areaServed: ['Lancaster, PA', 'Pennsylvania'],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'ProfessionalService',
		name: 'AI Wise Spaces',
		url: 'https://www.aiwisespaces.com/',
		image: 'https://www.aiwisespaces.com/aiwisespaces.png',
		description:
			'AI marketing help, AI-optimized websites, local SEO structure, and visibility systems for businesses in Lancaster PA and across Pennsylvania.',
		areaServed: [
			{ '@type': 'City', name: 'Lancaster' },
			{ '@type': 'AdministrativeArea', name: 'Pennsylvania' },
		],
		serviceType: ['AI-optimized websites', 'Local SEO strategy', 'Structured content systems'],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'AI Wise Spaces',
		url: 'https://www.aiwisespaces.com/',
		description:
			'AI visibility systems, Lancaster PA SEO support, structured content, and AI-optimized website builds for modern businesses.',
	},
];
---

<Layout
	title="AI Wise Spaces | Lancaster PA AI Websites, SEO, and Growth Systems"
	description="AI Wise Spaces helps Lancaster PA and Pennsylvania businesses improve AI visibility with AI-optimized websites, local SEO structure, semantic clarity, and lead-capture systems."
	keywords="Lancaster PA SEO, Lancaster PA marketing agency, Pennsylvania local SEO, AI visibility, AI-optimized website, structured content, semantic clarity, recommended by AI, AI growth system"
	schema={homeSchema}
>
	<main id="main-content" tabindex="-1">
			<section class="hero-section container">
				<div class="hero-copy">
					<p class="eyebrow">AI VISIBILITY. STRUCTURED FOR TRUST.</p>
					<h1>
						<span class="hero-line hero-line-tight">Websites Designed to Be</span>
						<strong class="gradient-text hero-strong">Understood and Recommended by AI.</strong>
					</h1>
					<p class="hero-text">
						We build AI-optimized websites with structured content, semantic clarity, and
						lead-capture systems that help businesses become visible across recommendation surfaces.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#final-cta">Book an AI Visibility Audit</a>
						<a class="button button-secondary" href="/services">Explore Services</a>
					</div>
					<div class="proof-row">
						<div class="avatar-stack" aria-hidden="true">
							{proofAvatars.map((avatar) => <span>{avatar}</span>)}
						</div>
						<div class="proof-block">
							<p>Trusted by businesses improving AI visibility and AI presence</p>
						</div>
						<div class="proof-block proof-rating">
							<span class="proof-stars">★★★★★</span>
							<span class="proof-label">5.0 from 30+ reviews</span>
						</div>
					</div>
				</div>
				<div class="hero-visual" aria-hidden="true">
					<div class="hero-glow"></div>
					<div class="panel-stack" data-active-story="clarity">
						<div class="panel panel-one"></div>
						<div class="panel panel-two"></div>
						<div class="panel panel-three"></div>
						<div class="panel panel-four"></div>
						<div class="panel panel-five"></div>
						<div class="panel panel-six"></div>
						<div class="story-card-stack" data-story-stack>
							{heroStories.map((story, index) => (
								<button
									type="button"
									class={`story-card${index === 0 ? ' is-active' : ''}`}
									data-story-trigger
									data-story-id={story.id}
									aria-pressed={index === 0 ? 'true' : 'false'}
								>
									<span class="story-card-step">0{index + 1}</span>
									<strong>{story.title}</strong>
									<small>{story.text}</small>
								</button>
							))}
						</div>
					</div>
				</div>
			</section>

			<section class="container logo-strip-section">
				<div class="logo-strip">
					<p class="eyebrow">TRUSTED BY FORWARD-THINKING BUSINESSES</p>
					<div class="logo-list">
						{logos.map((logo) => (
							<span>
								<strong>{logo.name}</strong>
								<small>{logo.location}</small>
							</span>
						))}
					</div>
				</div>
			</section>

			<section id="services" class="container content-section">
				<div class="services-intro">
					<div class="section-heading compact services-copy">
						<p class="eyebrow">OUR SERVICES</p>
						<h2>
							Everything Your Business Needs to
							<span class="gradient-text">Improve AI Visibility</span>
						</h2>
					</div>
					<p class="services-summary">
						From audits to structured content systems, we make your business machine-readable
						 and easier for AI to interpret at every layer.
					</p>
				</div>
				<div class="services-grid">
					{services.map((service) => (
						<article class="service-card">
							<div class={`icon-badge icon-${service.icon}`}>
								<UiIcon name={service.icon} />
							</div>
							<h3>{service.title}</h3>
							<p>{service.description}</p>
							<a href="/services">Learn more →</a>
						</article>
					))}
				</div>
			</section>

			<section class="container stats-section">
				<div class="stats-card">
					<p class="eyebrow stats-eyebrow">WHY AI VISIBILITY MATTERS</p>
					<div class="stats-grid">
						{stats.map((stat) => (
							<div class="stat-item">
								<div class={`stat-icon icon-${stat.icon}`}>
									<UiIcon name={stat.icon} />
								</div>
								<strong>{stat.value}</strong>
								<p>{stat.label}</p>
							</div>
						))}
					</div>
				</div>
			</section>

			<section id="process" class="container content-section">
				<div class="section-heading">
					<p class="eyebrow">OUR PROCESS</p>
					<h2>Simple. Strategic. Effective.</h2>
				</div>
				<div class="process-timeline">
					{process.map((item) => (
						<article class="process-step">
							<div class="timeline-node">
								<UiIcon name={item.icon} />
							</div>
							<p class="step-number">{item.step}</p>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</article>
					))}
				</div>
			</section>

			<section id="pricing" class="container content-section">
				<div class="section-heading">
					<p class="eyebrow">PRICING</p>
					<h2>Choose the level of AI visibility support your business needs.</h2>
				</div>
				<div class="pricing-grid">
					{pricing.map((tier) => {
						const pricingDisplay = getPricingDisplay(tier);

						return (
						<article class={`pricing-card${tier.featured ? ' featured' : ''}`}>
							<div class="pricing-head">
								<p class="pricing-label">{tier.featured ? 'Popular' : tier.priceNote}</p>
								<h3>{tier.name}</h3>
								<p class="pricing-summary">{tier.bestFor}</p>
							</div>
							<div class="pricing-price-row">
								{pricingDisplay.prefix && <span class="pricing-prefix">{pricingDisplay.prefix}</span>}
								<strong class="price">{pricingDisplay.amount}</strong>
								<span class="pricing-cycle">{pricingDisplay.cycle}</span>
							</div>
							<div class="pricing-section-label pricing-section-label-muted">What you get</div>
							<ul class="pricing-perks">
								{tier.perks.map((perk) => <li>{perk}</li>)}
							</ul>
							<div class="pricing-section-label pricing-section-label-muted">Includes</div>
							<ul class="pricing-features">
								{tier.features.map((feature) => <li>{feature}</li>)}
							</ul>
							<a class="button button-primary" href="#final-cta">Book a Free Audit</a>
						</article>
						);
					})}
				</div>
			</section>

			<section class="container content-section">
				<div class="section-heading">
					<p class="eyebrow">FAQ</p>
					<h2>Questions we hear before a project starts.</h2>
				</div>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details class="faq-item">
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>

			<ContactSubmissionSection />
	</main>
	<script is:inline>
		const storyStack = document.querySelector('[data-story-stack]');
		const panelStack = document.querySelector('.panel-stack');
		const storyButtons = Array.from(document.querySelectorAll('[data-story-trigger]'));

		if (storyStack && panelStack && storyButtons.length > 0) {
			storyButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const storyId = button.getAttribute('data-story-id');
					if (!storyId) {
						return;
					}

					panelStack.setAttribute('data-active-story', storyId);
					storyButtons.forEach((candidate) => {
						const isActive = candidate === button;
						candidate.classList.toggle('is-active', isActive);
						candidate.setAttribute('aria-pressed', String(isActive));
					});
				});
			});
		}
	</script>
</Layout>
