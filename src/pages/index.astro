---
import {
	faqs,
	logos,
	pricing,
	proofAvatars,
	process,
	services,
	stats,
} from '../data/siteContent.js';
import PageAnswerSummary from '../components/PageAnswerSummary.astro';
import ContactSubmissionSection from '../features/contact/components/ContactSubmissionSection.astro';
import QuickAuditSidebar from '../components/QuickAuditSidebar.astro';
import Layout from '../layouts/Layout.astro';
import UiIcon from '../components/UiIcon.astro';

function getPricingDisplay(tier: { name: string; price: string }) {
	if (tier.name === 'Website Rebuild') {
		return {
			prefix: 'Starting from',
			amount: '$1,500',
			cycle: '/project',
		};
	}

	if (tier.name === 'Growth System') {
		return {
			prefix: '',
			amount: '$450',
			cycle: '/month',
		};
	}

	return {
		prefix: '',
		amount: tier.price,
		cycle: '/project',
	};
}

const homeSchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'LocalBusiness',
		'@id': 'https://aiwisespaces.com/#localbusiness',
		name: 'AI Wise Spaces',
		url: 'https://aiwisespaces.com',
		image: 'https://aiwisespaces.com/aiwisespaces.png',
		description:
			'AI Wise Spaces builds AI-optimized websites that help local businesses become more visible in AI assistants, search engines, and local discovery.',
		areaServed: ['Lancaster PA', 'York PA', 'Harrisburg PA', 'Reading PA', 'Allentown PA', 'West Chester PA', 'King of Prussia PA', 'Wilmington DE', 'United States'],
		serviceType: [
			'AI-ready website development',
			'AI visibility optimization',
			'Local SEO',
			'Answer Engine Optimization',
			'Website migration from WordPress',
			'Website migration from Wix',
			'Website migration from Squarespace',
			'JSON-LD schema setup',
			'llms.txt setup',
			'robots.txt optimization',
		],
		knowsAbout: [
			'AI search visibility',
			'Answer Engine Optimization',
			'Local SEO',
			'Astro websites',
			'Tailwind CSS websites',
			'Structured data',
			'Schema markup',
			'Website performance',
		],
		makesOffer: [
			{
				'@type': 'Offer',
				itemOffered: {
					'@type': 'Service',
					name: 'AI Visibility Audit',
					description:
						'An audit that checks whether a local business website is structured for AI discovery and local recommendations.',
				},
			},
			{
				'@type': 'Offer',
				itemOffered: {
					'@type': 'Service',
					name: 'AI-Ready Website Development',
					description:
						'Custom website development focused on fast performance, structured content, local visibility, and AI-readable pages.',
				},
			},
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		'@id': 'https://aiwisespaces.com/#organization',
		name: 'AI Wise Spaces',
		url: 'https://aiwisespaces.com',
		logo: 'https://aiwisespaces.com/aiwisespaces.png',
		description:
			'AI Wise Spaces helps businesses upgrade from traditional website builders to AI-optimized websites.',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: [
			{
				'@type': 'Question',
				name: 'What is an AI-ready website?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'An AI-ready website is structured so search engines and AI assistants can clearly understand the business, services, location, expertise, and customer value.',
				},
			},
			{
				'@type': 'Question',
				name: 'Can you migrate a website from WordPress, Wix, or Squarespace?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Yes. AI Wise Spaces helps businesses move from WordPress, Wix, and Squarespace to faster, cleaner, AI-optimized websites.',
				},
			},
			{
				'@type': 'Question',
				name: 'Do you help local businesses show up in AI search?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Yes. AI Wise Spaces improves website structure, schema, content clarity, local pages, and AI-readable files to improve local AI visibility.',
				},
			},
		],
	},
];

const quickAuditChecks = [
	{
		icon: 'search',
		title: 'AI Visibility',
		description: 'How easily AI tools can find and understand your business.',
	},
	{
		icon: 'shield',
		title: 'Trust & Credibility',
		description: 'Signals that build trust with customers and AI systems.',
	},
	{
		icon: 'document',
		title: 'Content Structure',
		description: 'How well your site is organized and explains what you do.',
	},
	{
		icon: 'chart',
		title: 'Recommendation Potential',
		description: 'Your likelihood of being recommended over competitors.',
	},
];

const answerEngineHighlights = [
	{
		title: 'Who we help',
		detail: 'Contractors and local service businesses that want more qualified calls from search, maps, and AI assistants.',
	},
	{
		title: 'What we improve',
		detail: 'Messaging clarity, service pages, local SEO, structured data, conversion paths, and site speed.',
	},
	{
		title: 'Why it matters',
		detail: 'Google and AI systems recommend businesses they can understand quickly and trust confidently.',
	},
	{
		title: 'Best next step',
		detail: 'Start with a free visibility audit to see what is blocking trust, rankings, and lead quality.',
	},
];
---

<Layout
	title="AI Wise Spaces | AI-Ready Websites for the New Search Era"
	description="AI Wise Spaces builds fast, structured, AI-ready websites that help businesses become easier for people to trust and easier for AI assistants to understand, cite, and recommend."
	keywords="AI optimized websites, AI visibility, local SEO Lancaster PA, answer engine optimization, AI-ready websites, Astro websites, WordPress alternative, Wix alternative, Squarespace alternative"
	socialImagePath="/og-default.svg"
	schema={homeSchema}
>
	<main id="main-content" tabindex="-1">
			<section class="hero-section container">
				<div class="hero-copy">
					<p class="eyebrow">GOOGLE SEARCH. AI SEARCH. BETTER LEADS.</p>
					<div class="hero-title-block">
						<h1>
							<span class="hero-line hero-line-tight">Help Your Business</span>
							<strong class="gradient-text hero-strong">Show Up in AI Search.</strong>
						</h1>
					</div>
					<p class="hero-text">
						From contractors and salons to restaurants, gyms, yoga studios, photographers, and coffee shops, we structure your website so customers and AI tools can understand, trust, and recommend your business.
					</p>
					<div class="hero-actions">
						<a class="button button-primary hero-primary-button" href="/book-a-free-audit">
							<span class="button-icon-bars" aria-hidden="true"><span></span><span></span><span></span></span>
							<span>Get Your Free AI Visibility Audit</span>
						</a>
						<a class="button button-secondary hero-help-button" href="/services">
							<span class="button-icon-play" aria-hidden="true"></span>
							<span>See How We Help</span>
						</a>
					</div>
					<div class="proof-row">
						<div class="avatar-stack" aria-hidden="true">
							{proofAvatars.map((avatar) => <span>{avatar}</span>)}
						</div>
						<div class="proof-copy-row">
							<div class="proof-block">
								<p>Trusted by local businesses improving visibility, trust, and lead flow</p>
							</div>
							<div class="proof-block proof-rating">
								<span class="proof-stars">★★★★★</span>
								<span class="proof-label">5.0 from 30+ reviews</span>
							</div>
						</div>
					</div>
				</div>
				<div class="hero-spotlight" aria-label="AI visibility visual explanation">
					<div class="hero-spotlight-copy">
						<p class="hero-spotlight-kicker">AI Search</p>
						<p class="hero-spotlight-title">AI Wise Spaces</p>
						<p class="hero-spotlight-kicker">Better Leads</p>
					</div>
					<figure class="hero-spotlight-figure">
						<img
							class="hero-spotlight-image"
							src="/mission.png"
							alt="AI Wise Spaces mission graphic showing AI platforms and website systems connected through one optimized digital presence"
							loading="eager"
						/>
					</figure>
				</div>
				<QuickAuditSidebar checks={quickAuditChecks} />
			</section>

			<section class="container logo-strip-section">
				<div class="logo-strip">
					<p class="eyebrow">TRUSTED BY FORWARD-THINKING BUSINESSES</p>
					<div class="logo-list">
						{logos.map((logo) => (
							<span>
								<strong>{logo.name}</strong>
								<small>{logo.location}</small>
							</span>
						))}
					</div>
				</div>
			</section>

			<PageAnswerSummary
				id="answer-engine-title"
				title="What AI Wise Spaces does, in plain language."
				intro="A short, structured summary for busy visitors and answer engines evaluating relevance, trust, and local business fit."
				items={answerEngineHighlights.map((item) => ({ label: item.title, detail: item.detail }))}
				actions={[
					{ label: 'Explore services', href: '#services', variant: 'secondary' },
					{ label: 'See the process', href: '#process', variant: 'secondary' },
					{ label: 'Request your audit', href: '/book-a-free-audit', variant: 'primary' },
				]}
			/>

			<section id="services" class="container content-section">
				<div class="services-intro">
					<div class="section-heading compact services-copy">
						<p class="eyebrow">OUR SERVICES</p>
						<h2>
							Everything Your Business Needs to
							<span class="gradient-text">Get More Calls</span>
						</h2>
					</div>
					<p class="services-summary">
						From audits to service pages and technical cleanup, we help local service businesses turn their website into a clearer, more trusted sales tool for Google and AI search.
					</p>
				</div>
				<div class="services-grid">
					{services.map((service) => (
						<article class="service-card">
							<div class={`icon-badge icon-${service.icon}`}>
								<UiIcon name={service.icon} />
							</div>
							<h3>{service.title}</h3>
							<p>{service.description}</p>
							<a href="/services">Learn more →</a>
						</article>
					))}
				</div>
			</section>

			<section class="container stats-section">
				<div class="stats-card">
					<p class="eyebrow stats-eyebrow">WHAT THIS SHOULD DO</p>
					<div class="stats-grid">
						{stats.map((stat) => (
							<div class="stat-item">
								<div class={`stat-icon icon-${stat.icon}`}>
									<UiIcon name={stat.icon} />
								</div>
								<strong>{stat.value}</strong>
								<p>{stat.label}</p>
							</div>
						))}
					</div>
				</div>
			</section>

			<section id="process" class="container content-section">
				<div class="section-heading">
					<p class="eyebrow">OUR PROCESS</p>
					<h2>Simple. Clear. Built to get better leads.</h2>
				</div>
				<div class="process-timeline">
					{process.map((item) => (
						<article class="process-step">
							<div class="timeline-node">
								<UiIcon name={item.icon} />
							</div>
							<p class="step-number">{item.step}</p>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</article>
					))}
				</div>
			</section>

			<section id="pricing" class="container content-section">
				<div class="section-heading">
					<p class="eyebrow">PRICING</p>
					<h2>Choose the support level that fits your <span class="title-accent">next growth move.</span></h2>
				</div>
				<div class="pricing-grid">
					{pricing.map((tier) => {
						const pricingDisplay = getPricingDisplay(tier);

						return (
						<article class={`pricing-card${tier.featured ? ' featured' : ''}`}>
							<div class="pricing-head">
								<p class="pricing-label">{tier.featured ? 'Popular' : tier.priceNote}</p>
								<h3>{tier.name}</h3>
								<p class="pricing-summary">{tier.bestFor}</p>
							</div>
							<div class="pricing-price-row">
								{pricingDisplay.prefix && <span class="pricing-prefix">{pricingDisplay.prefix}</span>}
								<strong class="price">{pricingDisplay.amount}</strong>
								<span class="pricing-cycle">{pricingDisplay.cycle}</span>
							</div>
							<div class="pricing-section-label pricing-section-label-muted">What you get</div>
							<ul class="pricing-perks">
								{tier.perks.map((perk) => <li>{perk}</li>)}
							</ul>
							<div class="pricing-section-label pricing-section-label-muted">Includes</div>
							<ul class="pricing-features">
								{tier.features.map((feature) => <li>{feature}</li>)}
							</ul>
							<a class="button button-primary" href="/book-a-free-audit">Book a Free Audit</a>
						</article>
						);
					})}
				</div>
			</section>

			<section class="container content-section">
				<div class="section-heading">
					<p class="eyebrow">FAQ</p>
					<h2>Questions we hear before a project starts.</h2>
				</div>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details class="faq-item">
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>

			<ContactSubmissionSection />
	</main>
	<script is:inline type="module" src="/scripts/quick-audit-sidebar.js"></script>
</Layout>
