---
import PageAnswerSummary from '../components/PageAnswerSummary.astro';
import UiIcon from '../components/UiIcon.astro';
import { process, serviceAreas, services } from '../data/siteContent.js';
import Layout from '../layouts/Layout.astro';

const seoPages = [
	{
		title: 'Roofing Marketing Lancaster, PA',
		description: 'SEO and website help for Lancaster roofers who want more local leads.',
		href: '/roofing-marketing-lancaster-pa',
	},
	{
		title: 'Plumber Website Lancaster, PA',
		description: 'Website and local SEO help for Lancaster plumbers who need more calls.',
		href: '/plumber-website-lancaster-pa',
	},
	{
		title: 'Contractor Leads Pennsylvania',
		description: 'A statewide page for contractors who need a better website and stronger lead flow.',
		href: '/contractor-leads-pennsylvania',
	},
	{
		title: 'WordPress Website Upgrade',
		description: 'Upgrade slow or outdated WordPress business pages for AI search, AEO, and better lead flow.',
		href: '/wordpress-website-upgrade-lancaster-pa',
	},
	{
		title: 'AI Solutions Lancaster, PA',
		description: 'Practical AI solutions for Lancaster County and Pennsylvania businesses that need stronger visibility and better lead flow.',
		href: '/ai-solutions-lancaster-pa',
	},
];

const servicesSummaryItems = [
	{
		label: 'Best fit',
		detail: 'Local service businesses with decent traffic but weak messaging, trust signals, or conversion paths.',
	},
	{
		label: 'Primary outcomes',
		detail: 'Clearer offers, stronger service pages, better local visibility, and more qualified calls.',
	},
	{
		label: 'What is included',
		detail: 'Audit work, page structure, local SEO support, content direction, and technical cleanup where it matters.',
	},
	{
		label: 'Recommended next step',
		detail: 'Start with the audit if you need priorities first, or move into a rebuild if the current site is holding everything back.',
	},
];

const pageSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'AI Web Marketing and AEO Services for Lancaster County and Pennsylvania Businesses',
	serviceType: 'AI web marketing, AI solutions, Answer Engine Optimization, local SEO, website strategy, and content structure',
	provider: {
		'@type': 'Organization',
		name: 'AI Wise Spaces',
		url: 'https://aiwisespaces.com',
	},
	areaServed: ['Lancaster County PA', 'Pennsylvania'],
	description:
		'AI Wise Spaces helps Lancaster County and Pennsylvania business owners improve AI web marketing, AI solutions, AEO readiness, website clarity, local SEO, trust, and lead generation.',
};

const wordpressUpgradeItems = [
	'Upgrade slow or bloated WordPress business pages into a cleaner lead-generation structure.',
	'Rebuild the most valuable service pages first so rankings and conversion paths improve where they matter.',
	'Migrate from plugin-heavy layouts to faster, easier-to-trust pages built for AEO and local SEO.',
];
---

<Layout
	title="Services | AI Solutions, SEO & Website Strategy | AI Wise Spaces"
	description="Explore AI solutions, AI web marketing, AEO, local SEO, and website strategy services built for Lancaster County and Pennsylvania business owners."
	keywords="AI solutions services Lancaster County, AI web marketing services Pennsylvania, AEO services Pennsylvania, local SEO services PA, AI visibility services, website strategy"
	socialImagePath="/og-services.svg"
	schema={pageSchema}
>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="container page-hero">
			<p class="eyebrow">SERVICES</p>
			<h1 class="page-title">Website marketing services built to get <span class="title-accent">more qualified calls, not more noise.</span></h1>
			<p class="page-lede">We help Lancaster County and Pennsylvania business owners improve AI web marketing, AI solutions readiness, AEO readiness, local SEO, and lead flow with clearer websites and stronger search positioning.</p>
		</section>

		<PageAnswerSummary
			id="services-summary-title"
			title="What these services are designed to fix."
			intro="This page is structured to answer the practical questions a buyer or AI assistant asks first before recommending a service provider."
			items={servicesSummaryItems}
			actions={[
				{ label: 'See pricing', href: '/pricing', variant: 'secondary' },
				{ label: 'Request free audit', href: '/book-a-free-audit', variant: 'primary' },
			]}
		/>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">LOCAL FOCUS</p>
					<h2>Built for businesses that need a website customers and AI tools can trust faster.</h2>
				</div>
				<p class="page-lede">We structure service pages, local signals, and content systems so nearby customers can understand what your business does and so Google and AI tools can recommend it more confidently.</p>
			</div>
		</section>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">WORDPRESS UPGRADE PATH</p>
					<h2>We help WordPress website owners upgrade the business pages that should be producing better leads.</h2>
				</div>
				<p class="page-lede">If your current WordPress site feels slow, hard to manage, or full of generic service pages, we can rebuild the page structure into something faster, clearer, and more useful for AI search and local buyers.</p>
				<ul class="bullet-list compact-bullet-list">
					{wordpressUpgradeItems.map((item) => <li>{item}</li>)}
				</ul>
				<div class="hero-actions">
					<a class="button button-secondary" href="/wordpress-website-upgrade-lancaster-pa">See WordPress upgrade page</a>
					<a class="button button-secondary" href="/book-a-free-audit">Request a WordPress review</a>
				</div>
			</div>
		</section>

		<section class="container page-section">
			<div class="detail-grid">
				{services.map((service) => (
					<article class="detail-card">
						<div class={`icon-badge icon-${service.icon}`}>
							<UiIcon name={service.icon} />
						</div>
						<p class="case-label">{service.bestFor}</p>
						<h2>{service.title}</h2>
						<p>{service.description}</p>
						<ul class="bullet-list">
							{service.deliverables.map((item) => <li>{item}</li>)}
						</ul>
					</article>
				))}
			</div>
		</section>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">HOW WE WORK</p>
					<h2>Each service is built to make your offer clearer and your site easier to trust.</h2>
				</div>
				<div class="mini-process-grid">
					{process.map((item) => (
						<div class="mini-process-step">
							<div class="timeline-node">
								<UiIcon name={item.icon} />
							</div>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">LOCAL PAGES</p>
					<h2>Explore city-specific website marketing help pages across Pennsylvania.</h2>
				</div>
				<div class="detail-grid">
					{serviceAreas.map((area) => (
						<article class="detail-card">
							<p class="case-label">{area.city}, {area.state}</p>
							<h2>{area.city} Website Marketing Help</h2>
							<p>{area.description}</p>
							<a class="button button-secondary" href={`/locations/${area.slug}`}>View local page</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">SEO PAGES</p>
					<h2>High-intent search pages built around real service and location terms.</h2>
				</div>
				<div class="detail-grid">
					{seoPages.map((page) => (
						<article class="detail-card">
							<p class="case-label">Targeted search page</p>
							<h2>{page.title}</h2>
							<p>{page.description}</p>
							<a class="button button-secondary" href={page.href}>View page</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">NEXT STEPS</p>
					<h2>Use the right entry point for your current SEO and website problem.</h2>
				</div>
				<div class="detail-grid">
					<article class="detail-card compact-detail-card">
						<p class="case-label">Start with clarity</p>
						<h2>Need priorities first?</h2>
						<p>Begin with the free review or pricing page if you need to understand scope before committing to deeper work.</p>
						<div class="hero-actions">
							<a class="button button-secondary" href="/pricing">See pricing</a>
							<a class="button button-secondary" href="/book-a-free-audit">Request a review</a>
						</div>
					</article>
					<article class="detail-card compact-detail-card">
						<p class="case-label">See proof</p>
						<h2>Want examples before you decide?</h2>
						<p>Review the case studies and blog articles to see how clearer messaging, stronger structure, and better local intent improve lead flow.</p>
						<div class="hero-actions">
							<a class="button button-secondary" href="/case-studies">View case studies</a>
							<a class="button button-secondary" href="/blog">Read the blog</a>
						</div>
					</article>
				</div>
			</div>
		</section>
	</main>
</Layout>