---
import UiIcon from '../components/UiIcon.astro';
import { process, services } from '../data/siteContent.js';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Lancaster PA AI SEO Services | AI Audits, Websites, and Growth Systems"
	description="Explore AI Wise Spaces services for Lancaster PA and Pennsylvania businesses, including AI visibility audits, local SEO structure, AI-optimized website builds, and structured content systems."
	keywords="Lancaster PA SEO services, Lancaster PA marketing help, Pennsylvania local SEO, AI visibility audit, AI-optimized website, AI presence, structured content strategy"
>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="container page-hero">
			<p class="eyebrow">SERVICES</p>
			<h1 class="page-title">AI websites, SEO structure, and visibility systems for Lancaster PA and Pennsylvania businesses.</h1>
			<p class="page-lede">We help local businesses improve semantic clarity, trust, service-page structure, and AI visibility without turning the work into jargon or unnecessary complexity.</p>
		</section>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">LOCAL FOCUS</p>
					<h2>Built for businesses that want to be found in Lancaster, across Pennsylvania, and inside AI-driven discovery.</h2>
				</div>
				<p class="page-lede">We structure service pages, local signals, and content systems so nearby customers and AI assistants can understand what your business does and when to recommend it.</p>
			</div>
		</section>

		<section class="container page-section">
			<div class="detail-grid">
				{services.map((service) => (
					<article class="detail-card">
						<div class={`icon-badge icon-${service.icon}`}>
							<UiIcon name={service.icon} />
						</div>
						<p class="case-label">{service.bestFor}</p>
						<h2>{service.title}</h2>
						<p>{service.description}</p>
						<ul class="bullet-list">
							{service.deliverables.map((item) => <li>{item}</li>)}
						</ul>
					</article>
				))}
			</div>
		</section>

		<section class="container page-section">
			<div class="page-band">
				<div class="section-heading compact">
					<p class="eyebrow">HOW WE WORK</p>
					<h2>Each service is scoped to give you a clearer site, not more noise.</h2>
				</div>
				<div class="mini-process-grid">
					{process.map((item) => (
						<div class="mini-process-step">
							<div class="timeline-node">
								<UiIcon name={item.icon} />
							</div>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</div>
					))}
				</div>
			</div>
		</section>
	</main>
</Layout>