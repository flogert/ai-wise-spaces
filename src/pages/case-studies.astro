---
import PageAnswerSummary from '../components/PageAnswerSummary.astro';
import { caseStudies } from '../data/siteContent.js';
import Layout from '../layouts/Layout.astro';

const caseStudySummaryItems = [
	{
		label: 'What these show',
		detail: 'How clearer structure, stronger trust signals, and better page intent improve the usefulness of a website.',
	},
	{
		label: 'Why they matter',
		detail: 'Examples help buyers understand the kind of transformation they are actually paying for.',
	},
	{
		label: 'What to look for',
		detail: 'Notice the before-and-after difference in clarity, authority, and how easily a visitor can understand the offer.',
	},
	{
		label: 'Best next step',
		detail: 'Use these case studies to assess fit, then move to services or pricing if the same issues show up on your site.',
	},
];

const pageSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'AI Wise Spaces case studies',
	description:
		'Examples of website clarity, structure, and trust improvements for service businesses.',
};
---

<Layout
	title="Case Studies | AI Visibility & Website Results | AI Wise Spaces"
	description="See case studies showing how clearer messaging, stronger service pages, better structure, and local trust signals improve website performance."
	keywords="AI visibility case studies, contractor website case studies, local SEO results, service page improvement examples, website strategy results"
	socialImagePath="/og-case-studies.svg"
	schema={pageSchema}
>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="container page-hero">
			<p class="eyebrow">CASE STUDIES</p>
			<h1 class="page-title">Example outcomes for businesses that needed <span class="title-accent">a better website,</span> not more noise.</h1>
			<p class="page-lede">These use cases show the kinds of clarity, structure, and trust improvements that help service businesses get found more easily and turn more visits into leads.</p>
		</section>

		<PageAnswerSummary
			id="case-studies-summary-title"
			title="What these case studies are proving."
			intro="Case studies should shorten the buyer's evaluation process, not just decorate the site with vague success language."
			items={caseStudySummaryItems}
			actions={[
				{ label: 'View services', href: '/services', variant: 'secondary' },
				{ label: 'Request a review', href: '/book-a-free-audit', variant: 'primary' },
			]}
		/>

		<section class="container page-section">
			<div class="case-grid">
				{caseStudies.map((study) => (
					<article class="case-card">
						<div class="case-card-header">
							<p class="case-label">{study.industry}</p>
							<h2>{study.title}</h2>
							<p>{study.summary}</p>
						</div>
						<div class="case-card-section">
							<p><strong>Problem:</strong> {study.problem}</p>
							<p><strong>Solution:</strong> {study.solution}</p>
							<p><strong>Result:</strong> {study.result}</p>
						</div>
						<ul class="case-card-list">
							{study.highlights.map((highlight) => <li>{highlight}</li>)}
						</ul>
						<a class="button button-secondary" href={`/case-studies/${study.slug}`}>Read More</a>
					</article>
				))}
			</div>
		</section>
	</main>
</Layout>