---
import { caseStudies } from '../data/siteContent.js';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Website Marketing Case Studies | Clearer Websites and Better Lead Flow"
	description="See examples of how clearer service pages, better structure, and stronger local trust signals improve website performance for service businesses."
	keywords="website marketing case studies, contractor website examples, local SEO results, service page improvement examples"
>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="container page-hero">
			<p class="eyebrow">CASE STUDIES</p>
			<h1 class="page-title">Example outcomes for businesses that needed <span class="title-accent">a better website,</span> not more noise.</h1>
			<p class="page-lede">These use cases show the kinds of clarity, structure, and trust improvements that help service businesses get found more easily and turn more visits into leads.</p>
		</section>

		<section class="container page-section">
			<div class="case-grid">
				{caseStudies.map((study) => (
					<article class="case-card">
						<div class="case-card-header">
							<p class="case-label">{study.industry}</p>
							<h2>{study.title}</h2>
							<p>{study.summary}</p>
						</div>
						<div class="case-card-section">
							<p><strong>Problem:</strong> {study.problem}</p>
							<p><strong>Solution:</strong> {study.solution}</p>
							<p><strong>Result:</strong> {study.result}</p>
						</div>
						<ul class="case-card-list">
							{study.highlights.map((highlight) => <li>{highlight}</li>)}
						</ul>
						<a class="button button-secondary" href={`/case-studies/${study.slug}`}>Read More</a>
					</article>
				))}
			</div>
		</section>
	</main>
</Layout>