---
import PageAnswerSummary from '../../components/PageAnswerSummary.astro';
import { blogPosts } from '../../data/siteContent.js';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export function getStaticPaths() {
	return blogPosts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const post = Astro.props.post ?? blogPosts.find((entry) => entry.slug === Astro.params.slug);
const pageTitle = post ? `${post.title} | Blog | AI Wise Spaces` : 'Article Not Found | AI Wise Spaces';
const pageDescription = post?.summary ?? 'The requested article could not be found.';
const pageKeywords = post
	? `${post.title}, ${post.category}, AI visibility blog, local SEO article, website strategy article`
	: 'AI visibility blog, local SEO article';
const pageSchema = post
	? {
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		mainEntityOfPage: `https://aiwisespaces.com/blog/${post.slug}`,
		url: `https://aiwisespaces.com/blog/${post.slug}`,
		headline: post.title,
		description: post.summary,
		articleSection: post.category,
		publisher: {
			'@type': 'Organization',
			name: 'AI Wise Spaces',
			url: 'https://aiwisespaces.com',
		},
	}
	: undefined;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	keywords={pageKeywords}
	ogType="article"
	articleSection={post?.category}
	socialImagePath="/og-blog.svg"
	schema={pageSchema}
>
	<main id="main-content" class="page-main" tabindex="-1">
		{post ? (
			<>
		<section class="container page-hero">
			<p class="eyebrow">{post.category}</p>
			<h1 class="page-title"><span class="title-accent">{post.title}</span></h1>
			<p class="page-lede">{post.summary}</p>
		</section>

		<PageAnswerSummary
			id="blog-post-summary-title"
			title="What this article is meant to answer."
			intro={post.preview}
			items={post.sections.map((section) => ({ label: section.heading, detail: section.content }))}
			actions={[
				{ label: 'Back to articles', href: '/blog', variant: 'secondary' },
				{ label: 'Request a review', href: '/book-a-free-audit', variant: 'primary' },
			]}
		/>

		<section class="container page-section">
			<div class="page-band">
				<p>{post.preview}</p>
			</div>
		</section>

		<section class="container page-section">
			<div class="info-stack">
				{post.sections.map((section) => (
					<article class="stack-card article-card">
						<h2>{section.heading}</h2>
						<p>{section.content}</p>
					</article>
				))}
			</div>
		</section>

		<section class="container page-section">
			<a class="button button-secondary" href="/blog">Back to Articles</a>
		</section>
			</>
		) : (
			<section class="container page-section">
				<div class="page-band">
					<h1 class="page-title">Article not found</h1>
					<p class="page-lede">This article could not be found. Browse the blog for available posts.</p>
					<a class="button button-secondary" href="/blog">Back to Articles</a>
				</div>
			</section>
		)}
	</main>
</Layout>
