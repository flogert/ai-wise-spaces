---
import { navigation } from '../data/siteContent.js';
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand-column">
			<a href="/" class="brand-mark footer-brand" aria-label="AI Wise Spaces home">
				<img class="brand-logo" src="/aiwisespaces.png" alt="AI Wise Spaces logo" />
				<span class="brand-copy">
					<strong>AI Wise Spaces</strong>
					<small>Visible. Understandable. Recommended.</small>
				</span>
			</a>
			<p>Websites, service pages, and local SEO systems built to help contractors and local businesses get more calls.</p>
		</div>
		<nav class="footer-links" aria-label="Footer navigation">
			<strong>Navigate</strong>
			{navigation.map((item) => (
				<a href={item.href}>{item.label}</a>
			))}
		</nav>
		<div class="footer-links footer-contact-links">
			<strong>Contact</strong>
			<a href="/book-a-free-audit">Submit Inquiry</a>
			<a href="mailto:flogertbardhi@gmail.com">flogertbardhi@gmail.com</a>
			<a href="/services">View Service Offerings</a>
			<a href="/locations">View Service Areas</a>
		</div>
		<div class="footer-meta">
			<strong>Built For</strong>
			<p>Businesses that want more local jobs, a clearer offer, and better lead flow from their website.</p>
			<p>© 2026 AI Wise Spaces. Built for the new search era.</p>
		</div>
	</div>
</footer>