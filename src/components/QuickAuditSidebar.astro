---
import UiIcon from './UiIcon.astro';

const { checks = [] } = Astro.props as {
	checks?: Array<{
		icon: 'search' | 'shield' | 'document' | 'chart';
		title: string;
		description: string;
	}>;
};
---

<aside class="hero-sidebar quick-audit-sidebar" aria-label="Quick website score preview">
	<div class="quick-audit-intro-card">
		<div class="quick-audit-header">
			<p class="eyebrow">QUICK SNEAK PEEK</p>
			<h2>Preview how AI models read your website.</h2>
		</div>
		<form id="quick-audit-form" class="quick-audit-form">
			<div class="quick-audit-entry-row">
				<label>
					<span>Website URL</span>
					<input type="text" name="websiteUrl" inputmode="url" placeholder="yourwebsite.com" required />
				</label>
				<div class="quick-audit-actions">
					<button class="button button-preview-score" type="submit">Preview My Score</button>
				</div>
			</div>
			<p id="quick-audit-status" class="form-status" role="status" aria-live="polite"></p>
		</form>
	</div>
	<div class="quick-audit-stage">
		<div id="quick-audit-mission" class="quick-audit-mission-panel">
			<div class="quick-audit-checks-heading">
				<span class="quick-audit-checks-line" aria-hidden="true"></span>
				<p class="eyebrow">We Check What Matters</p>
				<span class="quick-audit-checks-line" aria-hidden="true"></span>
			</div>
			<div class="quick-audit-checks-list">
				{checks.map((check) => (
					<div class="quick-audit-check-item">
						<div class={`quick-audit-check-icon quick-audit-check-icon-${check.icon}`}>
							<UiIcon name={check.icon} />
						</div>
						<div class="quick-audit-check-copy">
							<strong>{check.title}</strong>
							<p>{check.description}</p>
						</div>
					</div>
				))}
			</div>
		</div>
		<div id="quick-audit-result" class="quick-audit-result" hidden>
			<div class="quick-audit-score-row">
				<div class="quick-audit-score-copy">
					<p class="quick-audit-label">Estimated score</p>
					<strong id="quick-audit-overall">0/100</strong>
					<p id="quick-audit-summary" class="quick-audit-model-note">
						Preview blends live page structure, crawl readiness, and AI-readability signals across Google, ChatGPT, Claude, Perplexity, and Gemini.
					</p>
				</div>
				<div class="quick-audit-metrics">
					<span id="quick-audit-local-seo">Local SEO: 0</span>
					<span id="quick-audit-conversion">Conversion: 0</span>
				</div>
			</div>
			<p id="quick-audit-issue" class="quick-audit-note">Many sites miss files and signals like llms.txt, schema, FAQ structure, and crawl guidance that help AI tools understand, trust, and recommend them.</p>
			<a id="quick-audit-cta" class="button button-secondary" href="/book-a-free-audit">
				Request Free Website Review
			</a>
		</div>
	</div>
</aside>