---
import { navigation } from '../data/siteContent.js';

const { currentPath = '/' } = Astro.props;
type NavigationItem = (typeof navigation)[number];

const isActive = (item: NavigationItem) => Boolean(item.match && currentPath.startsWith(item.match));
const mobileMenuId = 'primary-mobile-menu';
---

<header class="site-header">
	<div class="container nav-bar">
		<a href="/" class="brand-mark" aria-label="AI Wise Spaces home">
			<img class="brand-logo" src="/aiwisespaces.png" alt="AI Wise Spaces logo" />
			<span class="brand-copy">
				<strong>AI Wise Spaces</strong>
			</span>
		</a>
		<nav class="desktop-nav" aria-label="Primary navigation">
			{navigation.map((item) => (
				<a href={item.href} aria-current={isActive(item) ? 'page' : undefined} class:list={[isActive(item) && 'is-active']}>
					<span>{item.label}</span>
				</a>
			))}
		</nav>
		<a class="button button-primary header-cta" href="/book-a-free-audit">Get Your Free Audit</a>
		<details class="mobile-nav" data-mobile-nav>
			<summary aria-label="Toggle navigation menu" aria-controls={mobileMenuId} aria-expanded="false">
				<span class="sr-only">Open navigation menu</span>
				<span class="burger-line burger-line-top"></span>
				<span class="burger-line burger-line-middle"></span>
				<span class="burger-line burger-line-bottom"></span>
			</summary>
			<div class="mobile-panel" id={mobileMenuId}>
				{navigation.map((item) => (
					<a href={item.href} aria-current={isActive(item) ? 'page' : undefined} class:list={[isActive(item) && 'is-active']}>
						<span>{item.label}</span>
					</a>
				))}
				<a class="button button-primary" href="/book-a-free-audit">Get Your Free Audit</a>
			</div>
		</details>
	</div>
</header>

<script is:inline type="module" src="/scripts/site-header.js"></script>