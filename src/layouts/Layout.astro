---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const {
	title = 'AI Wise Spaces | AI-Optimized Websites for Local Businesses',
	description = 'AI Wise Spaces builds AI-ready websites that help local businesses become more visible in AI assistants, search engines, and local discovery.',
	keywords = 'AI optimized websites, AI visibility, local SEO Lancaster PA, answer engine optimization, AI-ready websites, Astro websites, WordPress alternative, Wix alternative, Squarespace alternative',
	schema,
} = Astro.props as {
	title?: string;
	description?: string;
	keywords?: string;
	schema?: Record<string, unknown> | Array<Record<string, unknown>>;
};

const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ?? new URL('https://aiwisespaces.com');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImage = new URL('/aiwisespaces.png', siteUrl).toString();
const schemaItems = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': `${siteUrl.toString()}#website`,
		url: siteUrl.toString(),
		name: 'AI Wise Spaces',
		description,
		inLanguage: 'en-US',
		publisher: {
			'@id': `${siteUrl.toString()}#organization`,
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		'@id': `${siteUrl.toString()}#organization`,
		name: 'AI Wise Spaces',
		url: siteUrl.toString(),
		logo: socialImage,
		image: socialImage,
		description:
			'AI Wise Spaces builds AI-ready websites and local visibility systems that help service businesses get found, trusted, and recommended.',
		contactPoint: {
			'@type': 'ContactPoint',
			contactType: 'sales',
			email: 'flogertbardhi@gmail.com',
			availableLanguage: ['en'],
		},
	},
	...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/aiwisespaces.png" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content="index, follow" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="theme-color" content="#050816" />
		<meta name="author" content="AI Wise Spaces" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="AI Wise Spaces" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="AI Wise Spaces glowing document mark" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@aiwisespaces" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18126063191"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'AW-18126063191');
		</script>
		<title>{title}</title>
		{schemaItems.length > 0 && (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaItems)}></script>
		)}
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<div class="page-shell">
			<SiteHeader currentPath={currentPath} />
			<slot />
			<SiteFooter />
		</div>
		<Analytics />
	</body>
</html>
